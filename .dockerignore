# Build outputs — regenerated inside the image, never shipped from context.
dist/
dist-connector/
build/
**/build/

# VCS and gradle caches (the wrapper is not used; system gradle lives in the
# builder image).
.git/
.gitignore
.gradle/
**/.gradle/

# Non-Java SDKs (not included in Gradle build)
eventmesh-sdks/eventmesh-sdk-rust/
eventmesh-sdks/eventmesh-sdk-go/
eventmesh-sdks/eventmesh-sdk-c/

# Rust / Node build artifacts
**/target/
**/node_modules/

# IDE / editor cruft.
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Docs & misc
docs/
*.md
